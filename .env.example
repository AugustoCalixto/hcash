# URL base do HUB (homepage)
# Desenvolvimento:
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Produção:
# NEXT_PUBLIC_SITE_URL=https://herocashbrasil.com.br

# Domínio raiz para subdomínios em produção (maquininhas.*, crm.*, cliente.*)
# NEXT_PUBLIC_ROOT_DOMAIN=herocashbrasil.com.br

# Área do cliente por produto (URLs externas dos painéis de login)
NEXT_PUBLIC_CLIENT_AREA_MAQUININHAS_URL=https://cliente.herocashbrasil.com.br
NEXT_PUBLIC_CLIENT_AREA_CRM_URL=https://cliente.herocashbrasil.com.br
